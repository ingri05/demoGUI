<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="control.MenuController"
      alignment="CENTER"
      spacing="22"
      prefWidth="700"
      prefHeight="500"
      style="-fx-background-color: #F3F6FB;">

    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>

    <Label text="SGMMS"
           style="-fx-font-size: 36px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #17365D;"/>

    <Label text="Emergency Vehicle Management"
           style="-fx-font-size: 19px;
                  -fx-text-fill: #475569;"/>

    <Label text="Main Menu"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;"/>

    <Button text="Register Vehicle"
            onAction="#openVehicleRegistration"
            prefWidth="280"
            prefHeight="55"
            style="-fx-background-color: #1976D2;
                   -fx-text-fill: white;
                   -fx-font-size: 16px;
                   -fx-background-radius: 8;"/>

    <Button text="View Vehicles"
            onAction="#openVehicleList"
            prefWidth="280"
            prefHeight="55"
            style="-fx-background-color: #1976D2;
                   -fx-text-fill: white;
                   -fx-font-size: 16px;
                   -fx-background-radius: 8;"/>

    <Button text="Exit"
            onAction="#exitApplication"
            prefWidth="280"
            prefHeight="45"/>

</VBox>

